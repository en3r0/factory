#!/usr/bin/env bash
# Factory pre-commit hook (set per product repo with: git config core.hooksPath ~/Projects/factory/githooks).
# Blocks committing .env files and anything gitleaks recognizes as a secret. Never bypass with --no-verify.
set -euo pipefail

bad_env=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -vE '\.env\.example$' || true)
if [ -n "$bad_env" ]; then
  echo "factory pre-commit: refusing to commit env files:" >&2
  echo "$bad_env" | sed 's/^/  /' >&2
  echo "Unstage them (git restore --staged <file>). Secrets stay in .env, which is gitignored." >&2
  exit 1
fi

# Workflows decide what CI checks and what deploys: operator-only for every product. Agents are
# identified the same way as in factory-guard (a board run or a Hermes session).
if [ -n "${BOARD_RUN_ID:-}" ] || [ -n "${HERMES_HOME:-}" ]; then
  wf=$(git diff --cached --name-only --diff-filter=ACMRD | grep -E '^\.github/workflows/' || true)
  if [ -n "$wf" ]; then
    echo "factory pre-commit: agents may not change CI/deploy workflows (operator-only):" >&2
    echo "$wf" | sed 's/^/  /' >&2
    echo "Unstage them and escalate if the change is needed." >&2
    exit 1
  fi
fi

if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --no-banner --redact --exit-code 1 >&2; then
    echo "factory pre-commit: gitleaks found a possible secret in the staged changes (shown redacted above)." >&2
    echo "Remove it from the change. If it is a false positive, escalate; never use --no-verify." >&2
    exit 1
  fi
else
  echo "factory pre-commit: gitleaks not installed; secret scan skipped" >&2
fi
