[Unit]
Description=herdr-board daemon (factory)
After=default.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/board daemon start --foreground
ExecStop=%h/.local/bin/board daemon stop
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
